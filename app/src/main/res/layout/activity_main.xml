<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Stack Launcher POC"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!--
          Two independent panels side by side. Each one owns its own SurfaceView, its own
          VirtualDisplay and its own reparented task; ids are duplicated with a 0/1 suffix
          rather than <include>d because <include> cannot rename the inner ids.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Panel 0 -->
            <LinearLayout
                android:id="@+id/panelRoot0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/panel_background"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@color/panel_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:id="@+id/appTitle0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="No app selected"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/backButton0"
                        android:layout_width="46dp"
                        android:layout_height="34dp"
                        android:contentDescription="Back in hosted app"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="BACK"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/addButton0"
                        android:layout_width="40dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Choose app"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="+"
                        android:textSize="16sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <SurfaceView
                        android:id="@+id/hostSurface0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:keepScreenOn="true" />

                    <LinearLayout
                        android:id="@+id/emptyState0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Panel 1"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/emptyAddButton0"
                            android:layout_width="60dp"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:text="+"
                            android:textSize="20sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Panel 1 -->
            <LinearLayout
                android:id="@+id/panelRoot1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@color/panel_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:id="@+id/appTitle1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="No app selected"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/backButton1"
                        android:layout_width="46dp"
                        android:layout_height="34dp"
                        android:contentDescription="Back in hosted app"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="BACK"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/addButton1"
                        android:layout_width="40dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Choose app"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="+"
                        android:textSize="16sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <SurfaceView
                        android:id="@+id/hostSurface1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:keepScreenOn="true" />

                    <LinearLayout
                        android:id="@+id/emptyState1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Panel 2"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/emptyAddButton1"
                            android:layout_width="60dp"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:text="+"
                            android:textSize="20sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
